rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /workout_logs/{logId} {
      allow read, write: if false;
    }
    match /comentarios/{docId} {
      allow create: if request.auth != null
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500
        && (!('autor' in request.resource.data) || (request.resource.data.autor is string && request.resource.data.autor.size() <= 60))
        && request.resource.data.fecha is string;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
